---
import Base from '../../layouts/Base.astro';
---

<Base title="JWT 解析" desc="拆解 JWT 结构并校验过期时间">
  <h1 class="page-title">JWT 解析</h1>
  <p class="page-desc">
    只做解码，不验证签名——本页没有密钥，也无法确认签发方，签名是否合法需服务端校验。
  </p>

  <div class="card">
    <label class="field-label" for="in">JWT</label>
    <textarea id="in" placeholder="粘贴完整 JWT（eyJ... 开头的三段式字符串）"></textarea>
    <div class="btn-row">
      <button class="btn primary" id="parse">解析</button>
      <button class="btn" id="clr">清空</button>
    </div>
    <div class="msg" id="msg"></div>
  </div>

  <div class="card">
    <label class="field-label" for="out">解析结果</label>
    <textarea id="out" readonly style="min-height: 260px"></textarea>
  </div>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const inp = $<HTMLTextAreaElement>('in');
  const out = $<HTMLTextAreaElement>('out');
  const msg = $('msg');

  const b64urlDecode = (s: string) => {
    let x = s.replace(/-/g, '+').replace(/_/g, '/');
    while (x.length % 4) x += '=';
    const bin = atob(x);
    return new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
  };

  function fmtTime(sec: number) {
    const d = new Date(sec * 1000);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ` +
           `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
  }

  $('parse').addEventListener('click', () => {
    const raw = inp.value.trim();
    if (!raw) {
      out.value = '';
      msg.textContent = '';
      return;
    }
    const parts = raw.split('.');
    if (parts.length !== 3) {
      out.value = '';
      msg.textContent = `✗ 应该正好是 3 段（header.payload.signature），实际是 ${parts.length} 段`;
      msg.className = 'msg err';
      return;
    }
    const [h, p, s] = parts;
    let header: Record<string, unknown>, payload: Record<string, unknown>;
    try {
      header = JSON.parse(b64urlDecode(h));
    } catch {
      out.value = '';
      msg.textContent = '✗ Header 段不是合法的 Base64URL / JSON';
      msg.className = 'msg err';
      return;
    }
    try {
      payload = JSON.parse(b64urlDecode(p));
    } catch {
      out.value = '';
      msg.textContent = '✗ Payload 段不是合法的 Base64URL / JSON';
      msg.className = 'msg err';
      return;
    }

    const lines: string[] = [];
    lines.push('── Header ──');
    lines.push(JSON.stringify(header, null, 2));
    lines.push('');
    lines.push('── Payload ──');
    lines.push(JSON.stringify(payload, null, 2));

    const exp = payload.exp as number | undefined;
    const iat = payload.iat as number | undefined;
    if (typeof exp === 'number') {
      const now = Math.floor(Date.now() / 1000);
      const left = exp - now;
      lines.push('');
      lines.push('── 有效期 ──');
      if (typeof iat === 'number') lines.push(`签发 (iat)  ${fmtTime(iat)}`);
      lines.push(`过期 (exp)  ${fmtTime(exp)}`);
      if (left < 0) {
        lines.push(`⚠ 已过期 ${Math.abs(left)} 秒（约 ${Math.floor(Math.abs(left) / 86400)} 天前）`);
      } else {
        lines.push(`✓ 剩余 ${left} 秒（约 ${(left / 3600).toFixed(1)} 小时）`);
      }
    } else {
      lines.push('');
      lines.push('（Payload 中没有 exp 字段，未设置过期时间）');
    }
    lines.push('');
    lines.push(`── 签名段 ──${s ? `（长度 ${s.length}，未校验）` : '（空）'}`);

    out.value = lines.join('\n');
    msg.textContent = '✓ 已解码，签名未校验';
    msg.className = 'msg ok';
  });

  $('clr').addEventListener('click', () => {
    inp.value = '';
    out.value = '';
    msg.textContent = '';
  });
</script>
